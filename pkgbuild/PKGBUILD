pkgname=torrente
pkgver=0.3.0
pkgrel=1
pkgdesc='Download, find and sort torrents, the Omarchy way'
arch=('x86_64' 'aarch64')
url='https://github.com/nadalbatle/torrente'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal' 'qbittorrent-nox')
optdepends=('python: searching through qBittorrent search plugins')
makedepends=('gcc' 'make')
install=torrente.install
options=('!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/torrente "$pkgdir/usr/bin/torrente"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/torrente.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/torrente.svg"
  install -Dm644 "$startdir/torrente.desktop" "$pkgdir/usr/share/applications/torrente.desktop"
  install -Dm644 "$startdir/torrente-engine.service" "$pkgdir/usr/lib/systemd/user/torrente-engine.service"
  install -Dm644 "$startdir/torrente-daemon.service" "$pkgdir/usr/lib/systemd/user/torrente-daemon.service"

  # The Omarchy bar plugin. The shell loads plugins from the user's config,
  # so it is shipped here and linked in with `torrente plugin install`.
  local plugin="$pkgdir/usr/share/torrente/omarchy-plugin"
  install -Dm644 plugin/manifest.json "$plugin/manifest.json"
  install -Dm644 plugin/Panel.qml "$plugin/Panel.qml"
  install -Dm644 plugin/Model.js "$plugin/Model.js"
  for catalog in plugin/i18n/*.json; do
    install -Dm644 "$catalog" "$plugin/i18n/$(basename "$catalog")"
  done
}
